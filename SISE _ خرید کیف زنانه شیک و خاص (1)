@charset "utf-8";

.cart-lines { gap: 15px !important; }

.ci.glass { display: grid !important; grid-template-columns: 86px minmax(0px, 1fr) auto !important; align-items: center !important; gap: 12px !important; padding: 12px !important; border-radius: 23px !important; background: linear-gradient(135deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.035)) !important; border: 1px solid rgba(255, 255, 255, 0.28) !important; box-shadow: rgba(0, 0, 0, 0.17) 0px 16px 40px, rgba(255, 255, 255, 0.24) 0px 1px 0px inset !important; backdrop-filter: blur(30px) saturate(185%) !important; }

.ci.glass > img { background: rgba(255, 255, 255, 0.08); width: 86px !important; height: 100px !important; object-fit: cover !important; border-radius: 17px !important; }

.ci .m { min-width: 0px !important; display: flex !important; flex-direction: column !important; gap: 6px !important; }

.ci .m > b { font-size: 14px !important; line-height: 1.65 !important; }

.ci .qty { display: flex !important; align-items: center !important; gap: 6px !important; padding: 5px !important; border-radius: 99px !important; background: rgba(255, 255, 255, 0.09) !important; border: 1px solid rgba(255, 255, 255, 0.18) !important; }

.ci .qty button { width: 28px !important; height: 28px !important; border-radius: 50% !important; display: grid !important; place-items: center !important; background: rgba(255, 255, 255, 0.14) !important; }

.ci .x { width: 34px !important; height: 34px !important; border-radius: 50% !important; background: rgba(232, 110, 102, 0.13) !important; border: 1px solid rgba(232, 110, 102, 0.25) !important; }

.cpn.glass, .shp.glass, .tot.glass, .frm.glass { border-radius: 24px !important; background: linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.035)) !important; border: 1px solid rgba(255, 255, 255, 0.25) !important; box-shadow: rgba(0, 0, 0, 0.15) 0px 14px 36px, rgba(255, 255, 255, 0.2) 0px 1px 0px inset !important; backdrop-filter: blur(28px) saturate(180%) !important; }

.tot.glass { padding: 18px !important; gap: 11px !important; }

.tot .g { padding-top: 12px !important; border-top: 1px solid var(--gb) !important; font-size: 17px !important; }

.tot .g span:last-child { font-size: 20px !important; color: var(--accent2) !important; }

.frm.glass { padding: 18px !important; gap: 12px !important; }

.frm.glass .in, .cpn.glass .in { min-height: 48px !important; border-radius: 15px !important; background: rgba(255, 255, 255, 0.075) !important; border: 1px solid rgba(255, 255, 255, 0.2) !important; }

.cart-empty-state, .track-empty-state { position: relative !important; display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: center !important; gap: 13px !important; min-height: 255px !important; padding: 30px 22px !important; overflow: hidden !important; text-align: center !important; border-radius: 30px !important; background: linear-gradient(135deg, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.12) 52%, rgba(230, 190, 130, 0.16)) !important; border: 1px solid rgba(255, 255, 255, 0.62) !important; box-shadow: rgba(91, 65, 37, 0.1) 0px 18px 48px, rgba(255, 255, 255, 0.8) 0px 1px 0px inset, rgba(255, 255, 255, 0.22) 0px -1px 0px inset !important; backdrop-filter: blur(30px) saturate(165%) !important; }

.cart-empty-state::before, .track-empty-state::before { content: ""; position: absolute; inset: 0px; pointer-events: none; background: radial-gradient(circle at 50% 0px, rgba(255, 255, 255, 0.45), transparent 55%); opacity: 0.8; }

.cart-empty-state .empty-icon, .track-empty-state .empty-icon { position: relative; display: grid; place-items: center; width: 76px; height: 76px; border-radius: 25px; color: var(--accent2); background: linear-gradient(145deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.16)); border: 1px solid rgba(255, 255, 255, 0.72); box-shadow: rgba(111, 78, 39, 0.11) 0px 8px 24px, rgba(255, 255, 255, 0.85) 0px 1px 0px inset; }

.cart-empty-state .empty-icon svg, .track-empty-state .empty-icon svg { width: 36px !important; height: 36px !important; }

.cart-empty-state .empty-title, .track-empty-state .empty-title { position: relative; font-size: 18px !important; font-weight: 800 !important; color: var(--fg) !important; }

.cart-empty-state .empty-note, .track-empty-state .empty-note { position: relative; max-width: 330px; margin: 0px !important; font-size: 13px !important; line-height: 1.9 !important; color: var(--muted) !important; }

.cart-empty-state .btn { position: relative; margin-top: 3px !important; min-height: 48px !important; padding-inline: 27px !important; border-radius: 17px !important; box-shadow: rgba(170, 119, 55, 0.16) 0px 9px 22px !important; }

.track-empty-state { min-height: 210px !important; margin-top: 14px !important; }

.track-title + .track-search { display: flex !important; align-items: center !important; gap: 10px !important; padding: 12px !important; border-radius: 22px !important; background: rgba(255, 255, 255, 0.09) !important; border: 1px solid rgba(255, 255, 255, 0.26) !important; backdrop-filter: blur(26px) saturate(180%) !important; }

.track-title + .track-search .in { min-width: 0px !important; flex: 1 1 0% !important; padding: 11px 13px !important; border-radius: 14px !important; background: rgba(255, 255, 255, 0.075) !important; border: 1px solid rgba(255, 255, 255, 0.18) !important; }

.order-track-card { padding: 19px !important; border-radius: 24px !important; background: linear-gradient(145deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.035)) !important; border: 1px solid rgba(255, 255, 255, 0.25) !important; box-shadow: rgba(0, 0, 0, 0.15) 0px 14px 36px, rgba(255, 255, 255, 0.2) 0px 1px 0px inset !important; backdrop-filter: blur(28px) saturate(180%) !important; }

.order-track-card .tl { margin-top: 15px !important; padding-inline-start: 7px !important; }

